!/renders/neutron-v1/layer-4.png
!/renders/eyeball-v1/
/renders/eyeball-v1/*
!/renders/eyeball-v1/layer-1.png
!/renders/eyeball-v1/layer-2.png
!/renders/eyeball-v1/layer-3.png
!/renders/eyeball-v1/layer-4.png
